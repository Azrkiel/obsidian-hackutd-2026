# Pit Pal environment variables. Every one is optional: with none set the rules coach runs locally.
# Copy to .env (never committed) or set them in your shell. Never commit real keys or tokens.

# --- NVIDIA Nemotron (the coach's AI) ---
# Self-hosted Nemotron on a Brev H100 through the tunnel (scripts/nemotron_tunnel.sh). PitPal.bat finds it on its own.
NEMOTRON_BASE_URL=
NEMOTRON_BREV_MODEL=nemotron
NEMOTRON_API_KEY=
# NVIDIA's hosted API (build.nvidia.com); also enables the NVIDIA Magpie voice in PitPal.bat.
NVIDIA_API_KEY=
NEMOTRON_MODEL=
# OpenRouter fallback.
OPENROUTER_API_KEY=
NEMOTRON_OPENROUTER_MODEL=
# Tuning (defaults are fine; on vLLM/Brev raise MAX_TOKENS_THINK to 3000).
NEMOTRON_TRANSPORT=
NEMOTRON_REASONING_BUDGET=
NEMOTRON_MAX_TOKENS_THINK=
NEMOTRON_MAX_TOKENS_FAST=
ENGINE_THINK_DEADLINE_S=
ENGINE_FAST_DEADLINE_S=
ENGINE_TOTAL_DEADLINE_S=
ENGINE_PLAN_THINK_S=
ENGINE_PLAN_TOTAL_S=
ENGINE_EVAL_THINK_S=
ENGINE_EVAL_TOTAL_S=

# --- NVIDIA Magpie TTS (voice, with NVIDIA_API_KEY) ---
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_TTS_URL=
NVIDIA_TTS_VOICE=

# --- Shared race history (SpacetimeDB, optional; see docs/SPACETIMEDB.md) ---
# Normally set up once with scripts/spacetime_device.py setup (token stored in Windows Credential Manager).
SPACETIMEDB_URL=
SPACETIMEDB_DATABASE=
SPACETIMEDB_IDENTITY=
SPACETIMEDB_DEVICE_ID=
SPACETIMEDB_LABEL=
SPACETIMEDB_TOKEN=
SPACETIME_URL=
SPACETIME_DB=
SPACETIME_CLI=
HISTORY_PUBLIC_URL=

# Only if you reach the local dashboard through a tunnel or proxy: its origin(s), comma-separated. Normally leave empty.
# PITPAL_ALLOWED_ORIGINS=https://my-tunnel.example
